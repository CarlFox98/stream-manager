# Twitch API credentials
# Get these from https://dev.twitch.tv/console/apps
#   - Register an application.
#   - Set the OAuth Redirect URL to:  http://localhost:5000/auth/callback
#     (this is where the one-click login redirects back after you approve; if
#     the app binds a different port, the startup banner shows the exact URL).
#   - Client Type: either works. With a client secret below, the app uses the
#     standard secret exchange; leave the secret blank for a Public app and it
#     uses PKCE automatically.
# The SAME app powers both the read-only status polling and the interactive
# layer (chat + channel points). The first time you run with interactive
# features on, a browser window opens for you to click "Authorize" once — no
# codes to copy — and the token is cached locally in .twitch_user_token.json
# (gitignored) and auto-refreshed.
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# OBS WebSocket (optional) — enables real scene/stream/record status instead
# of just "is obs64.exe running". In OBS: Tools > WebSocket Server Settings >
# Enable WebSocket server, then copy the password shown there.
# Requires: pip install websocket-client
# OBS_WEBSOCKET_PASSWORD=your_obs_websocket_password
# OBS_WEBSOCKET_HOST=localhost
# OBS_WEBSOCKET_PORT=4455
